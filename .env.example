# Server
PORT=5000
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.com

# MongoDB (Atlas works the same regardless of whether you deploy on AWS, Azure or Render)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/leads?retryWrites=true&w=majority

# Gmail SMTP notifications (owner alert and requester confirmation; use a Gmail App Password,
# which requires 2-Step Verification to be enabled on the account)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
NOTIFY_EMAIL_TO=you@gmail.com

# WhatsApp notifications (Twilio). Start with the Twilio WhatsApp Sandbox for testing;
# move to a Twilio-approved WhatsApp Business sender before going live.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFY_WHATSAPP_TO=whatsapp:+910000000000

# Optional Vapi outbound verification call after a lead submits the form.
# This is separate from inbound calls, which are routed to your Vapi phone number.
ENABLE_VOICE_VERIFICATION=false
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Set this same secret in the Vapi server URL configuration.
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Frontend settings (VITE_ values are public and included in the browser build)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=+1 (202) 555-0147
VITE_VAPI_INBOUND_NUMBER=
VITE_WHATSAPP_NUMBER=
VITE_TOP_BANNER_TEXT=Thoughtful academic guidance, tailored around your goals
VITE_OFFER_ENABLED=false
VITE_OFFER_TITLE=Your first study session
VITE_OFFER_DESCRIPTION=Get 10% off your first request.
VITE_OFFER_CODE=WELCOME10
# For a separately hosted frontend, set:
# VITE_LEAD_FORM_ENDPOINT=https://your-api-domain.com/api/leads
# VITE_CHATBOT_API_ENDPOINT=https://your-api-domain.com/api/chat
# VITE_FEEDBACK_API_ENDPOINT=https://your-api-domain.com/api/feedback
